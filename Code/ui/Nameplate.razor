@using System;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

@*
	The tag over another player's head: rank emblem, name, and an emote for whatever is
	happening to them. A world-space PanelComponent on its own GameObject — PanelComponents can't
	nest, but each WorldPanel is a root of its own, so one per player is the shipped pattern.

	For this machine's own player only the emote shows; spectators show nothing. Rank colour on the name is a Silver+ perk; Master's name is gold (see Ranks).
*@

<root class="@RootClass">
	@if ( Visible )
	{
		<div class="tag">
			@if ( !string.IsNullOrEmpty( Emote ) )
			{
				<div class="bubble"><div class="emote" style="background-image: url(@Emote)"></div></div>
			}
			@if ( !IsLocal )
			{
				<div class="plate">
					<div class="emblem" style="background-image: url(@Ranks.Emblem( Player.RankPoints ))"></div>
					<label class="name" style="color: @NameColour">@Player.DisplayName</label>
				</div>
			}
		</div>
	}
</root>

@code
{
	public TntPlayer Player { get; set; }

	bool IsLocal => Player is not null && Player == TntPlayer.FindLocal( Scene );

	/// <summary>
	/// Other players get the whole tag. Your own player gets only the emote — you don't need your
	/// name over your head, but seeing the stars when you're floored is part of the joke.
	/// </summary>
	bool Visible => Player is not null && Player.IsValid() && Player.IsAlive && (!IsLocal || !string.IsNullOrEmpty( Emote ));

	string RootClass => Visible ? "" : "hidden";

	string NameColour
	{
		get
		{
			var tier = Player.RankTier;
			if ( tier < RankTier.Silver ) return "#FFF8EC";
			return Ranks.TierHex( tier );
		}
	}

	/// <summary>The emote that best says what's happening to them right now, if anything.</summary>
	string Emote
	{
		get
		{
			var status = Player.Status;
			if ( Player.IsRagdolled ) return "/ui/icons/emotes/dizzy.svg";
			if ( status.Has( StatusKind.Stunned ) ) return "/ui/icons/emotes/swirl.svg";
			if ( status.Has( StatusKind.Confused ) ) return "/ui/icons/emotes/question.svg";
			if ( status.Has( StatusKind.Blackout ) ) return "/ui/icons/emotes/sleep.svg";
			if ( status.Has( StatusKind.HeavyBoots ) ) return "/ui/icons/emotes/anger.svg";
			if ( status.Has( StatusKind.Glue ) ) return "/ui/icons/emotes/drops.svg";
			if ( status.Has( StatusKind.Vortex ) ) return "/ui/icons/emotes/alert.svg";
			if ( status.Has( StatusKind.Ice ) ) return "/ui/icons/emotes/chill.svg";
			return null;
		}
	}

	protected override int BuildHash() => Player is null
		? 0
		: HashCode.Combine( Visible, IsLocal, Player.DisplayName, Player.RankPoints, Emote );
}
