@using System;
@using System.Linq;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox

@*
	In-round HUD. Corners hold the slow-changing facts (who's left, the feed, your depth), the top
	centre the one number that matters right now, and the bottom centre the two things your hands
	do — your abilities — with your points beside them. Everything big and loud is a moment:
	"Run!", "Out!", a status landing on you, the room you just dropped into.
*@

<root>
	<div class="hud @StateClass">
		@if ( IsBlackedOut )
		{
			<div class="blackout"></div>
		}

		<div class="roundstate @UrgentClass">
			<div class="clock">
				<div class="glyph @StateGlyph"></div>
				<label class="headline">@Headline</label>
			</div>
			@if ( !string.IsNullOrEmpty( Subline ) )
			{
				<label class="subline">@Subline</label>
			}

			@if ( IsCountingDown )
			{
				<div class="drain">
					<div class="fill" style="width: @(CountdownPercent)%"></div>
				</div>
			}
		</div>

		<div class="alive">
			<div class="glyph g-players"></div>
			<label class="value">@AliveValue</label>
		</div>

		<div class="feed">
			@foreach ( var entry in VisibleFeed )
			{
				<div class="line" @key=@entry.Time>
					@if ( !string.IsNullOrEmpty( entry.By ) )
					{
						<label class="who by">@entry.By</label>
						<div class="glyph g-impact"></div>
					}
					else
					{
						<div class="glyph g-flame"></div>
					}
					<label class="who">@entry.Name</label>
					<label class="what">@FeedText( entry )</label>
				</div>
			}
		</div>

		<div class="ladder">
			@foreach ( var index in FloorIndices )
			{
				<div class="rung f@(index) @FloorClass( index )" @key=@index>
					@if ( index == CurrentFloor )
					{
						<div class="you glyph g-runner"></div>
					}
					<div class="bar">
						<div class="room">
							<div class="art" style="background-image: url(@ArenaGenerator.FloorIcon( index ))"></div>
						</div>
					</div>
				</div>
			}
			<div class="rung lava"><div class="bar"><div class="glyph g-flame"></div></div></div>
		</div>

		@if ( ShowAbilities )
		{
			<div class="bottom">
				<div class="statuses">
					@foreach ( var status in Statuses )
					{
						<div class="status @( PlayerStatus.IsDebuff( status ) ? "bad" : "good" )" @key=@status>
							<div class="art" style="background-image: url(@PlayerStatus.Icon( status ))"></div>
							<label class="what">@PlayerStatus.Label( status )</label>
							<label class="time">@StatusTime( status )</label>
						</div>
					}
				</div>

				<div class="bar-row">
					<div class="points">
						<div class="glyph g-star"></div>
						<label class="value">@PointsValue</label>
						<div class="popups">
							@foreach ( var popup in VisiblePopups )
							{
								<label class="popup" @key=@popup.Time>@PopupText( popup )</label>
							}
						</div>
					</div>

					@for ( var slot = 0; slot < 2; slot++ )
					{
						var s = slot;
						var info = AbilityCatalog.Get( SlotAbility( s ) );

						<div class="ability @( info.Kind == AbilityKind.Help ? "help" : "harm" ) @SlotState( s )" @key=@s>
							<div class="face">
								<div class="pop">
									<div class="art" style="background-image: url(@info.Icon)"></div>
								</div>
								<div class="cooldown" style="height: @(CooldownPercent( s ))%"></div>
								@if ( IsCooling( s ) )
								{
									<label class="seconds">@CooldownSeconds( s )</label>
								}
							</div>
							<div class="prompt" style="background-image: url(@PromptPath( s ))"></div>
						</div>
					}
				</div>
			</div>
		}

		@if ( ShowGo )
		{
			<div class="moment go">
				<div class="sunburst"></div>
				<label class="word">Run!</label>
			</div>
		}

		@if ( ShowEliminated )
		{
			<div class="moment out">
				<div class="glyph g-flame"></div>
				<label class="word">Out!</label>
				<label class="sub">@OutLine</label>
			</div>
		}

		@if ( ShowFloorToast )
		{
			<div class="floor-toast f@(_toastFloor)">
				<div class="badge">
					<div class="art" style="background-image: url(@ArenaGenerator.FloorIcon( _toastFloor ))"></div>
				</div>
				<div class="text">
					<label class="number">@ToastNumber</label>
					<label class="room">@ToastRoom</label>
				</div>
			</div>
		}

		@if ( IsSpectating )
		{
			<div class="spectate">
				<div class="glyph g-eye"></div>
				<label class="target">@SpectateName</label>
				@if ( HasSpectateTarget )
				{
					<div class="prompt wide" style="background-image: url(/ui/kenney/prompts/keyboard_space.svg)"></div>
					<label class="hint">Next player</label>
				}
			</div>
		}
	</div>
</root>

@code
{
	RoundManager Round => Scene.Get<RoundManager>();

	MatchScore Score => Scene.Get<MatchScore>();

	/// <summary>
	/// The player this client controls, resolved once per frame in <see cref="BuildHash"/>
	/// rather than on every read.
	/// </summary>
	TntPlayer LocalPlayer => _localPlayer;

	TntPlayer _localPlayer;

	const float FeedLifetime = 6f;

	/// <summary>How long the big "Out!" card holds before the spectator bar takes over.</summary>
	const float EliminatedCardTime = 2.5f;

	const float GoCardTime = 1.2f;

	const float PopupLifetime = 1.8f;

	TimeSince _sinceDeath;

	bool _wasAlive = true;

	int _lastCountdownSecond = -1;

	/// <summary>Deepest floor reached this life, for the "Out!" card.</summary>
	int _deepest;

	RoundManager.RoundState _lastState = RoundManager.RoundState.Waiting;

	bool IsCountingDown => Round?.IsCountingDown == true;

	float CountdownPercent
	{
		get
		{
			var round = Round;
			if ( round is null || round.CountdownDuration <= 0f ) return 0f;
			return (round.CountdownRemaining / round.CountdownDuration * 100f).Clamp( 0f, 100f );
		}
	}

	string UrgentClass => IsCountingDown && Round.CountdownRemaining <= 3f ? "urgent" : "";

	IEnumerable<int> FloorIndices => Enumerable.Range( 0, Arena.FloorCount );

	IEnumerable<RoundManager.FeedEntry> VisibleFeed => Round is null
		? Enumerable.Empty<RoundManager.FeedEntry>()
		: Round.Feed.Where( e => Time.Now - e.Time < FeedLifetime );

	int VisibleFeedCount => VisibleFeed.Count();

	/// <summary>One expression per label — mixing literal text and @expressions drops the literal.</summary>
	static string FeedText( RoundManager.FeedEntry entry ) => entry.Remaining == 1
		? "is out, 1 left"
		: $"is out, {entry.Remaining} left";

	int CurrentFloor
	{
		get
		{
			var player = LocalPlayer;
			if ( player is null || !player.IsAlive ) return -1;
			return player.CurrentFloor;
		}
	}

	string FloorClass( int index )
	{
		var floor = CurrentFloor;
		if ( floor < 0 ) return "below";
		if ( index == floor ) return "here";
		return index < floor ? "passed" : "below";
	}

	bool IsEliminated => LocalPlayer is not null && !LocalPlayer.IsAlive;

	bool ShowEliminated => IsEliminated
		&& Round?.State == RoundManager.RoundState.Playing
		&& _sinceDeath < EliminatedCardTime;

	string OutLine => _deepest <= 0 ? "Straight into the lava" : $"You made it to floor {_deepest + 1}";

	bool IsSpectating => IsEliminated
		&& Round?.State == RoundManager.RoundState.Playing
		&& !ShowEliminated;

	bool HasSpectateTarget => LocalPlayer?.SpectateTarget is not null;

	string SpectateName => LocalPlayer?.SpectateTarget?.DisplayName ?? "Nobody left standing";

	bool ShowGo => Round?.State == RoundManager.RoundState.Playing
		&& Round.RoundElapsed < GoCardTime
		&& !IsEliminated;

	bool ShowAbilities => LocalPlayer is not null && LocalPlayer.IsAlive && Round?.State != RoundManager.RoundState.Ended;

	bool IsBlackedOut => LocalPlayer is not null && LocalPlayer.IsAlive && LocalPlayer.Status.Has( StatusKind.Blackout );

	string StateClass
	{
		get
		{
			var round = Round;
			if ( round is null ) return "";
			if ( IsEliminated && round.State == RoundManager.RoundState.Playing ) return "dead";

			return round.State switch
			{
				RoundManager.RoundState.Waiting when round.IsCountingDown => "counting",
				RoundManager.RoundState.Playing => "playing",
				RoundManager.RoundState.Ended => "ended",
				_ => "waiting"
			};
		}
	}

	string Headline
	{
		get
		{
			var round = Round;
			if ( round is null ) return "-";

			return round.State switch
			{
				RoundManager.RoundState.Waiting when round.IsCountingDown => MathF.Ceiling( round.CountdownRemaining ).ToString( "0" ),
				RoundManager.RoundState.Waiting => $"{round.PlayerCount}/{round.MinPlayers}",
				RoundManager.RoundState.Playing => FormatTime( round.RoundElapsed ),
				RoundManager.RoundState.Ended => "Round over",
				_ => "-"
			};
		}
	}

	string Subline
	{
		get
		{
			var round = Round;
			if ( round is null ) return "";

			return round.State switch
			{
				RoundManager.RoundState.Waiting when round.IsCountingDown => "Get ready",
				RoundManager.RoundState.Waiting => "Warm-up",
				RoundManager.RoundState.Playing => "",
				_ => ""
			};
		}
	}

	/// <summary>The clock pill's sticker: a stopwatch while the round runs, an hourglass before it.</summary>
	string StateGlyph => Round?.State switch
	{
		RoundManager.RoundState.Playing => "g-clock",
		RoundManager.RoundState.Ended => "g-trophy",
		_ => "g-hourglass"
	};

	// --- Floor toast -------------------------------------------------------------------------

	/// <summary>How long "Floor 3 · Beach" stays after you drop into a room.</summary>
	const float FloorToastTime = 2.2f;

	int _toastFloor = -1;

	int _lastFloor = -1;

	TimeSince _sinceToast;

	bool ShowFloorToast => _toastFloor >= 0 && _sinceToast < FloorToastTime && !IsEliminated;

	string ToastNumber => $"Floor {_toastFloor + 1}";

	string ToastRoom => Scene.Get<ArenaGenerator>()?.FloorName( _toastFloor ) ?? "";

	string AliveValue => Round is null ? "-" : $"{Round.AliveCount}/{Round.PlayerCount}";

	// --- Abilities ---------------------------------------------------------------------------

	PlayerAbilities Abilities => LocalPlayer?.Abilities;

	AbilityId SlotAbility( int slot ) => Abilities?.InSlot( slot ) ?? AbilityId.None;

	bool IsCooling( int slot ) => Abilities is not null && Abilities.CooldownRemaining( slot ) > 0f;

	float CooldownPercent( int slot ) => Abilities is null ? 0f : (1f - Abilities.ReadyFraction( slot )) * 100f;

	string CooldownSeconds( int slot ) => MathF.Ceiling( Abilities.CooldownRemaining( slot ) ).ToString( "0" );

	string SlotState( int slot )
	{
		if ( Abilities is null ) return "";
		if ( !Abilities.CanCastNow ) return "blocked";
		return IsCooling( slot ) ? "cooling" : "ready";
	}

	static string PromptPath( int slot ) => slot == 0 ? "/ui/kenney/prompts/mouse_left.svg" : "/ui/kenney/prompts/mouse_right.svg";

	// --- Statuses ----------------------------------------------------------------------------

	IEnumerable<StatusKind> Statuses => LocalPlayer?.Status.Current ?? Enumerable.Empty<StatusKind>();

	string StatusTime( StatusKind kind ) => $"{MathF.Ceiling( LocalPlayer.Status.Remaining( kind ) ):0}s";

	// --- Points ------------------------------------------------------------------------------

	string PointsValue => (Score?.PointsOf( LocalPlayer ) ?? 0).ToString();

	IEnumerable<MatchScore.Popup> VisiblePopups => Score is null
		? Enumerable.Empty<MatchScore.Popup>()
		: Score.Popups.Where( p => Time.Now - p.Time < PopupLifetime );

	static string PopupText( MatchScore.Popup popup ) => $"+{popup.Amount} {popup.Reason}";

	static string FormatTime( float seconds )
	{
		var total = (int)seconds;
		return $"{total / 60:0}:{total % 60:00}";
	}

	/// <summary>
	/// The HUD's audio cues, kept with the visuals they belong to: a tick on each of the last
	/// three countdown seconds, a bong when the round goes live, and the moment of death.
	/// </summary>
	public override void Tick()
	{
		var round = Round;
		if ( round is null ) return;

		if ( round.IsCountingDown )
		{
			var second = (int)MathF.Ceiling( round.CountdownRemaining );
			if ( second != _lastCountdownSecond && second <= 3 && second > 0 )
				Sfx.Ui( Sfx.Tick, 0.7f );

			_lastCountdownSecond = second;
		}
		else
		{
			_lastCountdownSecond = -1;
		}

		if ( round.State != _lastState && round.State == RoundManager.RoundState.Playing )
		{
			Sfx.Ui( Sfx.Go, 0.7f );
			_deepest = 0;
		}

		_lastState = round.State;

		var floor = CurrentFloor;
		if ( floor > _deepest ) _deepest = floor;

		// Dropping a floor mid-round names the room you landed in. Respawns and new rounds start
		// higher up again, which never counts as a drop.
		if ( floor > _lastFloor && _lastFloor >= 0 && round.State == RoundManager.RoundState.Playing )
		{
			_toastFloor = floor;
			_sinceToast = 0f;
		}

		if ( floor >= 0 ) _lastFloor = floor;

		var alive = LocalPlayer?.IsAlive ?? true;
		if ( _wasAlive && !alive ) _sinceDeath = 0f;
		_wasAlive = alive;
	}

	protected override int BuildHash()
	{
		_localPlayer = TntPlayer.FindLocal( Scene );

		var abilities = Abilities;
		var cooldown = abilities is null ? 0 : HashCode.Combine( (int)(abilities.ReadyFraction( 0 ) * 40), (int)(abilities.ReadyFraction( 1 ) * 40), abilities.First, abilities.Second, abilities.CanCastNow );
		var statuses = LocalPlayer is null ? 0 : HashCode.Combine( LocalPlayer.Status.Revision, Statuses.Sum( s => (int)LocalPlayer.Status.Remaining( s ) ) );

		return HashCode.Combine(
			HashCode.Combine( Headline, Subline, AliveValue, CurrentFloor, VisibleFeedCount, Round?.FeedRevision ?? 0 ),
			HashCode.Combine( StateClass, UrgentClass, (int)CountdownPercent, ShowAbilities, IsBlackedOut ),
			HashCode.Combine( ShowGo, ShowEliminated, IsSpectating, SpectateName, ShowFloorToast, _toastFloor ),
			HashCode.Combine( cooldown, statuses, PointsValue, VisiblePopups.Count(), Score?.Revision ?? 0 ) );
	}
}
