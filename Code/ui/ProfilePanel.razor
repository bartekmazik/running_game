@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

@*
	Your rank, how close the next one is, your lifetime numbers, and what every tier unlocks.
	Ranks only ever change how you look in the arena — the ladder says exactly what each one adds.
*@

<root>
	<div class="card sheet">
		<div class="head">
			<i class="sparkle">auto_awesome</i>
			<label class="title">Your rank</label>
			<i class="sparkle">auto_awesome</i>
		</div>

		<div class="top">
			<div class="current">
				<div class="medallion" style="background-image: url(@Ranks.Emblem( Rp )); border-color: @Ranks.TierHex( Ranks.Tier( Rp ) )"></div>
				<div class="detail">
					<label class="rank">@Ranks.Name( Rp )</label>
					<label class="rp">@RpText</label>
					<div class="bar">
						<div class="fill" style="width: @(ProgressPercent)%"></div>
					</div>
					<label class="next">@NextText</label>
				</div>
			</div>

			<div class="stats">
				<div class="stat-row">
					<div class="stat">
						<label class="value">@P.Rounds</label>
						<label class="caption">Rounds</label>
					</div>
					<div class="stat">
						<label class="value">@P.Wins</label>
						<label class="caption">Wins</label>
					</div>
				</div>
				<div class="stat-row">
					<div class="stat">
						<label class="value">@P.Knockdowns</label>
						<label class="caption">Knockdowns</label>
					</div>
					<div class="stat">
						<label class="value">@BestText</label>
						<label class="caption">Best finish</label>
					</div>
				</div>
			</div>
		</div>

		<label class="ladder-title">What each rank adds</label>
		<div class="ladder">
			@foreach ( var tier in Tiers )
			{
				var t = tier;
				<div class="tier @TierClass( t )">
					<div class="emblem" style="background-image: url(@Ranks.EmblemOfStep( FirstStep( t ) )); border-color: @Ranks.TierHex( t )"></div>
					<label class="name">@t.ToString()</label>
					<label class="perk">@Ranks.Perk( t )</label>
					@if ( (int)t > (int)Ranks.Tier( Rp ) )
					{
						<i class="lock">lock</i>
					}
				</div>
			}
		</div>

		<label class="howto">Win rounds and knock people down to climb. Placing low costs a little; Bronze never drops below zero.</label>

		<div class="foot">
			<div class="brick paper" onclick=@Back>
				<i>arrow_back</i>
				<label>Back</label>
			</div>
		</div>
	</div>
</root>

@code
{
	ProfileStore Store => Scene.Get<ProfileStore>();

	PlayerProfile P => Store.Profile;

	int Rp => P.RankPoints;

	static RankTier[] Tiers => new[] { RankTier.Bronze, RankTier.Silver, RankTier.Gold, RankTier.Platinum, RankTier.Diamond, RankTier.Master };

	static int FirstStep( RankTier tier ) => tier == RankTier.Master ? 15 : (int)tier * 3;

	string TierClass( RankTier tier )
	{
		var current = Ranks.Tier( Rp );
		if ( tier == current ) return "current";
		return (int)tier < (int)current ? "earned" : "locked";
	}

	string RpText => $"{Rp} RP";

	float ProgressPercent => Ranks.Progress( Rp ) * 100f;

	string NextText
	{
		get
		{
			var (_, next) = Ranks.Bounds( Rp );
			var step = Ranks.Step( Rp );
			if ( step >= Ranks.StepCount - 1 ) return "Top of the tower.";
			return $"{next - Rp} RP to {Ranks.NameOfStep( step + 1 )}";
		}
	}

	string BestText => P.BestPlace <= 0 ? "-" : $"#{P.BestPlace}";

	void Back()
	{
		Sfx.Ui( Sfx.Back, 0.5f );
		Scene.Get<GameUi>().Open( GameUi.MenuPage.Title );
	}

	protected override int BuildHash() => HashCode.Combine( Store?.Revision );
}
