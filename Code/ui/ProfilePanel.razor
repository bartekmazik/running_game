@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

@*
	Your rank as one picture: the emblem on its rays, the name, how far to the next step, four
	numbers, and the six tiers in a row. Ranks only ever change how you look in the arena; hovering a
	tier says what it adds.
*@

<root>
	<div class="card sheet">
		<div class="hero">
			<div class="medallion">
				<div class="sunburst"></div>
				<div class="twinkle t1"></div>
				<div class="twinkle t2"></div>
				<div class="emblem">
					<div class="art" style="background-image: url(@Ranks.Emblem( Rp ))"></div>
				</div>
			</div>

			<div class="title-row">
				<div class="swirl left"></div>
				<label class="title">@Ranks.Name( Rp )</label>
				<div class="swirl right"></div>
			</div>

			<div class="bar">
				<div class="fill" style="width: @(ProgressPercent)%; background-color: @Ranks.TierHex( Ranks.Tier( Rp ) )"></div>
			</div>
			<label class="rp">@RpText</label>
		</div>

		<div class="stats">
			<div class="stat"><div class="glyph g-runner"></div><label class="value">@P.Rounds</label></div>
			<div class="stat"><div class="glyph g-trophy"></div><label class="value">@P.Wins</label></div>
			<div class="stat"><div class="glyph g-impact"></div><label class="value">@P.Knockdowns</label></div>
			<div class="stat"><div class="glyph g-medal"></div><label class="value">@BestText</label></div>
		</div>

		<div class="ladder">
			@foreach ( var tier in Tiers )
			{
				var t = tier;
				<div class="tier @TierClass( t )" @key=@t>
					<div class="emblem">
						<div class="art" style="background-image: url(@Ranks.EmblemOfStep( FirstStep( t ) ))"></div>
					</div>
					<label class="name">@t.ToString()</label>
					<label class="perk">@Ranks.Perk( t )</label>
					@if ( (int)t > (int)Ranks.Tier( Rp ) )
					{
						<div class="glyph g-lock lock"></div>
					}
				</div>
			}
		</div>

		<div class="brick paper back" onclick=@Back>
			<div class="glyph g-back"></div>
		</div>
	</div>
</root>

@code
{
	ProfileStore Store => Scene.Get<ProfileStore>();

	PlayerProfile P => Store.Profile;

	int Rp => P.RankPoints;

	static RankTier[] Tiers => new[] { RankTier.Bronze, RankTier.Silver, RankTier.Gold, RankTier.Platinum, RankTier.Diamond, RankTier.Master };

	static int FirstStep( RankTier tier ) => tier == RankTier.Master ? 15 : (int)tier * 3;

	string TierClass( RankTier tier )
	{
		var current = Ranks.Tier( Rp );
		if ( tier == current ) return "current";
		return (int)tier < (int)current ? "earned" : "locked";
	}

	float ProgressPercent => Ranks.Progress( Rp ) * 100f;

	/// <summary>"53 / 100 RP", or just the total at the top.</summary>
	string RpText
	{
		get
		{
			var (_, next) = Ranks.Bounds( Rp );
			if ( Ranks.Step( Rp ) >= Ranks.StepCount - 1 ) return $"{Rp} RP";
			return $"{Rp} / {next} RP";
		}
	}

	string BestText => P.BestPlace <= 0 ? "-" : $"#{P.BestPlace}";

	void Back()
	{
		Sfx.Ui( Sfx.Back, 0.5f );
		Scene.Get<GameUi>().Open( GameUi.MenuPage.Title );
	}

	protected override int BuildHash() => HashCode.Combine( Store?.Revision );
}
