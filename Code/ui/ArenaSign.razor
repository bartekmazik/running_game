@using System;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

@*
	Signage hung on the arena itself, built by ArenaGenerator on every machine (local, unnetworked).
	Two kinds: a floor plaque centred on every wall of every room — paper, the floor's number in ink,
	a rim in the floor's identity colour — and the trophy over the tower, Kenney's gold medal with the
	game's one rule under it. World-space PanelComponents, one per sign; they never rebuild.
*@

<root class="@KindClass">
	@if ( IsTrophy )
	{
		<div class="trophy">
			<div class="medal"></div>
			<label class="title">TNT Run</label>
			<label class="rule">Last one standing wins</label>
		</div>
	}
	else
	{
		<div class="plaque" style="border: 26px solid @FloorHex">
			<label class="number">@FloorNumber</label>
		</div>
	}
</root>

@code
{
	/// <summary>Floor index for a floor plate; -1 for the trophy.</summary>
	public int Floor { get; set; } = -1;

	bool IsTrophy => Floor < 0;

	string KindClass => IsTrophy ? "is-trophy" : "is-floor";

	string FloorNumber => (Floor + 1).ToString();

	string FloorHex
	{
		get
		{
			var c = ArenaGenerator.FloorColor( Floor );
			return $"#{(int)(c.r * 255):X2}{(int)(c.g * 255):X2}{(int)(c.b * 255):X2}";
		}
	}

	protected override int BuildHash() => Floor;
}
