@using System;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

@*
	The single root panel. Everything the player sees hangs off this one ScreenPanel.

	It exists because a PanelComponent cannot be nested inside another panel — only Panel
	subclasses can. So this is the only PanelComponent in the project, and every screen below it
	is a plain Panel.

	Its whole job is routing the one path through the game: menu → lobby list → game → results.
	Out of a session the menu owns the screen (title or lobby list); in one, the HUD does, with
	the results laid over it while a round is Ended. The screens own their content and their own
	BuildHash, so this rebuilds only when the route changes, not when a timer ticks.
*@

<root>
	<div class="gameui">
		@if ( InSession )
		{
			<HudPanel />

			@if ( ShowResults )
			{
				<ResultsPanel />
			}
		}
		else
		{
			<MenuPanel />
		}
	</div>
</root>

@code
{
	RoundManager Round => Scene.Get<RoundManager>();

	bool InSession => Networking.IsActive;

	bool ShowResults => Round?.State == RoundManager.RoundState.Ended;

	protected override int BuildHash() => System.HashCode.Combine( InSession, ShowResults );
}
