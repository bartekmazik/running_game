@using System;
@using System.Linq;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox

@*
	The end of a round, over the HUD while it's Ended: who won, the podium with its medals, everyone's
	points, what this round did to your rank — and, when it happened, the rank-up moment: a few seconds
	of the reference's "Level up!" card, which then settles into a pill on top of the results card.
*@

<root>
	<div class="card results">
		@if ( RankedUp )
		{
			<div class="rankup">
				<div class="emblem art" style="background-image: url(@Ranks.EmblemOfStep( Store.RankUpToStep ))"></div>
				<label class="to">@RankUpName</label>
			</div>
		}

		<div class="title-row">
			<div class="swirl left"></div>
			<label class="title">ROUND OVER</label>
			<div class="swirl right"></div>
		</div>
		<label class="verdict">@Verdict</label>
		<div class="meta">
			<div class="glyph g-clock"></div>
			<label>@DurationText</label>
		</div>

		<div class="podium">
			@foreach ( var place in PodiumOrder )
			{
				@if ( place <= Rows.Count )
				{
					var row = Rows[place - 1];
					<div class="step p@(place) @MineClass( row.Name )" @key=@place>
						<div class="medal">
							<div class="art" style="background-image: url(@Ranks.Medal( place ))"></div>
						</div>
						<div class="who">
							<div class="emblem art" style="background-image: url(@Ranks.Emblem( row.RankPoints ))"></div>
							<label class="name">@row.Name</label>
						</div>
						<label class="pts">@PointsText( row )</label>
						<div class="block"></div>
					</div>
				}
			}
		</div>

		@if ( Rows.Count > 3 )
		{
			<div class="table">
				@for ( var i = 3; i < Math.Min( Rows.Count, MaxRows ); i++ )
				{
					var row = Rows[i];
					<div class="row @MineClass( row.Name )" @key=@i>
						<label class="place">@PlaceText( i + 1 )</label>
						<div class="emblem art" style="background-image: url(@Ranks.Emblem( row.RankPoints ))"></div>
						<label class="name">@row.Name</label>
						<div class="kd"><div class="glyph g-impact"></div><label>@row.Knockdowns</label></div>
						<label class="pts">@PointsText( row )</label>
					</div>
				}
			</div>
		}

		@if ( ShowRank )
		{
			<div class="you">
				<div class="emblem art" style="background-image: url(@Ranks.Emblem( Rp ))"></div>
				<div class="mid">
					<label class="rank">@Ranks.Name( Rp ).ToUpperInvariant()</label>
					<div class="bar"><div class="fill" style="width: @(Ranks.Progress( Rp ) * 100f)%; background-color: @Ranks.TierHex( Ranks.Tier( Rp ) )"></div></div>
				</div>
				<label class="delta @DeltaClass">@DeltaText</label>
			</div>
		}

		<div class="foot">
			<div class="next">
				<div class="glyph g-hourglass"></div>
				<label>@NextText</label>
			</div>

			<div class="brick paper" onclick=@OpenLoadout>
				<div class="glyph g-bolt"></div>
				<label>ABILITIES</label>
			</div>
			<div class="brick coral" onclick=@Leave>
				<div class="glyph g-door"></div>
				<label>LEAVE</label>
			</div>
		</div>
	</div>

	@if ( Celebrating )
	{
		<div class="celebrate" onclick=@EndCelebration>
			<div class="levelup">
				<div class="badge">
					<div class="art" style="background-image: url(@Ranks.EmblemOfStep( Store.RankUpToStep ))"></div>
				</div>
				<div class="title-row">
					<div class="swirl left"></div>
					<label class="title">RANK UP!</label>
					<div class="swirl right"></div>
				</div>
				<label class="to">@RankUpName</label>
			</div>
		</div>
	}
</root>

@code
{
	RoundManager Round => Scene.Get<RoundManager>();

	ProfileStore Store => Scene.Get<ProfileStore>();

	const int MaxRows = 12;

	IReadOnlyList<RoundManager.ResultRow> Rows => Round.LastRows;

	/// <summary>Second, first, third — the classic podium silhouette.</summary>
	static int[] PodiumOrder => new[] { 2, 1, 3 };

	string LocalName => Connection.Local?.DisplayName ?? "";

	int Rp => Store?.Profile.RankPoints ?? 0;

	bool RankedUp => Store is not null && Store.RankUpToStep >= 0;

	string RankUpName => Ranks.NameOfStep( Store.RankUpToStep );

	bool ShowRank => Round.LastRoundRanked && Store is not null && Store.HasLastDelta;

	string DeltaText => Store.LastDelta >= 0 ? $"+{Store.LastDelta} RP" : $"{Store.LastDelta} RP";

	string DeltaClass => Store.LastDelta >= 0 ? "up" : "down";

	string Verdict => string.IsNullOrEmpty( Round.LastWinner )
		? "NOBODY MADE IT"
		: Round.LastWinner == LocalName ? "YOU WIN" : $"{Round.LastWinner.ToUpperInvariant()} WINS";

	string DurationText => FormatTime( Round.LastRoundDuration );

	string NextText => $"{MathF.Ceiling( Round.RestartRemaining ).Clamp( 0f, 99f ):0}";

	string MineClass( string name ) => name == LocalName ? "mine" : "";

	static string PlaceText( int place ) => $"#{place}";

	static string PointsText( RoundManager.ResultRow row ) => $"{row.Points} PTS";


	void OpenLoadout()
	{
		Sfx.Ui( Sfx.Click );
		var ui = Scene.Get<GameUi>();
		ui.LoadoutOpen = true;
		ui.StateHasChanged();
	}

	void Leave()
	{
		Sfx.Ui( Sfx.Back );
		Round.Leave();
	}

	static string FormatTime( float seconds )
	{
		var total = (int)seconds;
		return $"{total / 60:0}:{total % 60:00}";
	}

	// --- Rank-up moment ------------------------------------------------------------------------

	/// <summary>How long the full-screen rank-up holds before it settles into the pill on the card.</summary>
	const float CelebrationTime = 4.5f;

	bool _playedRankUp;

	bool _celebrationDismissed;

	TimeSince _sinceRankUp;

	bool Celebrating => RankedUp && !_celebrationDismissed && _sinceRankUp < CelebrationTime;

	void EndCelebration()
	{
		_celebrationDismissed = true;
		Sfx.Ui( Sfx.Click, 0.5f );
		StateHasChanged();
	}

	public override void Tick()
	{
		if ( RankedUp && !_playedRankUp )
		{
			_playedRankUp = true;
			_sinceRankUp = 0f;
			Sfx.Ui( Sfx.RankUp, 0.8f );
		}
	}

	protected override int BuildHash() => HashCode.Combine(
		Rows.Count, Round?.LastWinner, (int)(Round?.RestartRemaining ?? 0f), Store?.Revision, Store?.RankUpToStep, Store?.HasLastDelta, Celebrating );
}
