@using System;
@using System.Linq;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox

@*
	The end of a round, over the HUD while it's Ended: who won, the podium with Kenney's medals,
	everyone's points, what this round did to your rank — and, when it happened, the rank-up card,
	modelled on the "Level up!" card in the user's reference screenshots.
*@

<root>
	<div class="card results">
		@if ( RankedUp )
		{
			<div class="rankup">
				<div class="star"><div class="emblem" style="background-image: url(@Ranks.EmblemOfStep( Store.RankUpToStep ))"></div></div>
				<div class="text">
					<label class="title">Rank up!</label>
					<label class="to">@RankUpName</label>
				</div>
			</div>
		}

		<label class="verdict">@Verdict</label>
		<label class="duration">@DurationText</label>

		<div class="podium">
			@foreach ( var place in PodiumOrder )
			{
				@if ( place <= Rows.Count )
				{
					var row = Rows[place - 1];
					<div class="step p@(place) @MineClass( row.Name )">
						<div class="medal" style="background-image: url(@MedalPath( place ))"></div>
						<div class="emblem" style="background-image: url(@Ranks.Emblem( row.RankPoints ))"></div>
						<label class="name">@row.Name</label>
						<label class="pts">@PointsText( row )</label>
						<div class="block"><label>@PlaceText( place )</label></div>
					</div>
				}
			}
		</div>

		@if ( Rows.Count > 3 )
		{
			<div class="table">
				@for ( var i = 3; i < Math.Min( Rows.Count, MaxRows ); i++ )
				{
					var row = Rows[i];
					<div class="row @MineClass( row.Name )">
						<label class="place">@PlaceText( i + 1 )</label>
						<div class="emblem" style="background-image: url(@Ranks.Emblem( row.RankPoints ))"></div>
						<label class="name">@row.Name</label>
						<label class="kd">@KnockdownText( row )</label>
						<label class="pts">@PointsText( row )</label>
					</div>
				}
			</div>
		}

		@if ( ShowRank )
		{
			<div class="you">
				<div class="emblem" style="background-image: url(@Ranks.Emblem( Rp ))"></div>
				<div class="mid">
					<label class="rank">@Ranks.Name( Rp )</label>
					<div class="bar"><div class="fill" style="width: @(Ranks.Progress( Rp ) * 100f)%"></div></div>
				</div>
				<label class="delta @DeltaClass">@DeltaText</label>
			</div>
		}
		else if ( !Round.LastRoundRanked )
		{
			<label class="unranked">Solo rounds don't count towards rank.</label>
		}

		<div class="foot">
			<label class="next">@NextText</label>

			<div class="brick mint" onclick=@OpenLoadout>
				<i>bolt</i>
				<label>Abilities</label>
			</div>
			<div class="brick coral" onclick=@Leave>
				<i>logout</i>
				<label>Leave</label>
			</div>
		</div>
	</div>
</root>

@code
{
	RoundManager Round => Scene.Get<RoundManager>();

	ProfileStore Store => Scene.Get<ProfileStore>();

	const int MaxRows = 12;

	IReadOnlyList<RoundManager.ResultRow> Rows => Round.LastRows;

	/// <summary>Second, first, third — the classic podium silhouette.</summary>
	static int[] PodiumOrder => new[] { 2, 1, 3 };

	string LocalName => Connection.Local?.DisplayName ?? "";

	int Rp => Store?.Profile.RankPoints ?? 0;

	bool RankedUp => Store is not null && Store.RankUpToStep >= 0;

	string RankUpName => $"You're now {Ranks.NameOfStep( Store.RankUpToStep )}";

	bool ShowRank => Round.LastRoundRanked && Store is not null && Store.HasLastDelta;

	string DeltaText => Store.LastDelta >= 0 ? $"+{Store.LastDelta} RP" : $"{Store.LastDelta} RP";

	string DeltaClass => Store.LastDelta >= 0 ? "up" : "down";

	string Verdict => string.IsNullOrEmpty( Round.LastWinner )
		? "Nobody made it"
		: Round.LastWinner == LocalName ? "You win!" : $"{Round.LastWinner} wins";

	string DurationText => $"Round lasted {FormatTime( Round.LastRoundDuration )}";

	string NextText => $"Next warm-up in {MathF.Ceiling( Round.RestartRemaining ).Clamp( 0f, 99f ):0}";

	string MineClass( string name ) => name == LocalName ? "mine" : "";

	static string MedalPath( int place ) => place switch
	{
		1 => "/ui/kenney/medals/medal_3.svg",
		2 => "/ui/kenney/medals/medal_2.svg",
		_ => "/ui/kenney/medals/medal_1.svg"
	};

	static string PlaceText( int place ) => $"#{place}";

	static string PointsText( RoundManager.ResultRow row ) => $"{row.Points} pts";

	static string KnockdownText( RoundManager.ResultRow row ) => row.Knockdowns == 1 ? "1 knockdown" : $"{row.Knockdowns} knockdowns";

	void OpenLoadout()
	{
		Sfx.Ui( Sfx.Click );
		var ui = Scene.Get<GameUi>();
		ui.LoadoutOpen = true;
		ui.StateHasChanged();
	}

	void Leave()
	{
		Sfx.Ui( Sfx.Back );
		Round.Leave();
	}

	static string FormatTime( float seconds )
	{
		var total = (int)seconds;
		return $"{total / 60:0}:{total % 60:00}";
	}

	bool _playedRankUp;

	public override void Tick()
	{
		if ( RankedUp && !_playedRankUp )
		{
			_playedRankUp = true;
			Sfx.Ui( Sfx.RankUp, 0.8f );
		}
	}

	protected override int BuildHash() => HashCode.Combine(
		Rows.Count, Round?.LastWinner, (int)(Round?.RestartRemaining ?? 0f), Store?.Revision, Store?.RankUpToStep, Store?.HasLastDelta );
}
