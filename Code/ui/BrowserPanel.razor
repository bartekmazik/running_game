@using System;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Network;
@namespace Sandbox

@* The lobby list, shown inside MenuPanel's column in place of the host-or-browse buttons. *@

<root>
	<div class="card browser">
		<div class="titlebar">
			<div class="brick paper square" onclick=@Back>
				<div class="glyph g-back"></div>
			</div>
			<div class="titles">
				<label class="title">FIND A GAME</label>
				<label class="status @( Browser.JoinFailed ? "error" : "" )">@StatusText</label>
			</div>
			<div class="brick sky square @BusyClass" onclick=@Refresh>
				<div class="glyph g-refresh"></div>
			</div>
		</div>

		<div class="list">
			@if ( Browser.Lobbies.Count == 0 )
			{
				<div class="empty">
					<div class="glyph @( Browser.IsQuerying ? "g-hourglass spin" : "g-search" )"></div>
					<label class="headline">@EmptyHeadline</label>
				</div>
			}

			@foreach ( var lobby in Browser.Lobbies )
			{
				<div class="row @FullClass( lobby )" @key=@lobby.LobbyId onclick=@( () => Join( lobby ) )>
					<div class="cell name">
						<label class="primary">@lobby.Name</label>
						<label class="secondary">@Subtitle( lobby )</label>
					</div>
					<label class="cell state">@StateLabel( lobby )</label>
					<label class="cell players">@Headcount( lobby )</label>
					<div class="join">
						<div class="glyph @JoinIcon( lobby )"></div>
					</div>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	LobbyBrowser Browser => Scene.Get<LobbyBrowser>();

	string BusyClass => Browser.IsQuerying ? "disabled" : "";

	string StatusText
	{
		get
		{
			var browser = Browser;
			if ( browser.JoinFailed ) return "Couldn't join";

			var count = browser.Lobbies.Count;
			return count == 0 || browser.IsQuerying ? "" : $"{count} open";
		}
	}

	string EmptyHeadline => Browser.IsQuerying ? "SEARCHING" : "NO OPEN LOBBIES";

	void Refresh()
	{
		Sfx.Ui( Sfx.Click );
		Browser.Refresh();
	}

	void Back()
	{
		Sfx.Ui( Sfx.Back );
		Scene.Get<GameUi>().Open( GameUi.MenuPage.Title );
	}

	void Join( LobbyInformation lobby )
	{
		if ( lobby.IsFull )
		{
			Sfx.Ui( Sfx.Deny );
			return;
		}

		Sfx.Ui( Sfx.Confirm );
		Browser.Join( lobby );
	}

	/// <summary>
	/// Who hosts it. That comes from Networking.SetData on the hosting machine, so it is
	/// "?" whenever a lobby is up but has not published yet.
	/// </summary>
	string Subtitle( LobbyInformation lobby ) => lobby.Get( "host", "?" );

	string Headcount( LobbyInformation lobby ) => $"{lobby.Members}/{lobby.MaxMembers}";

	/// <summary>RoundManager publishes its enum name; this is the player-facing word for it.</summary>
	string StateLabel( LobbyInformation lobby ) => lobby.Get( "state", "" ) switch
	{
		"Waiting" => "Warming up",
		"Playing" => $"Playing · {lobby.Get( "alive", "?" )} left",
		"Ended" => "Results",
		_ => "Starting"
	};

	string FullClass( LobbyInformation lobby ) => lobby.IsFull ? "full" : "";

	/// <summary>A full lobby shows a padlock where the play button would be.</summary>
	string JoinIcon( LobbyInformation lobby ) => lobby.IsFull ? "g-lock" : "g-play";

	// Revision covers every content change — a lobby whose alive-count moved bumps it without
	// the list length changing.
	protected override int BuildHash() => Browser is null
		? 0
		: System.HashCode.Combine( Browser.Revision, Browser.IsQuerying, Browser.JoinFailed );
}
