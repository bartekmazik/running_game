@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox

@*
	The out-of-session shell: the title screen with its host-or-browse choice, and the lobby list
	behind the second option. Both sit over the live arena — MenuCamera orbits it — on the left
	third of the screen, so the world itself is the backdrop.
*@

<root>
	<div class="menu @( Browsing ? "browsing" : "title" )">
		<div class="scrim"></div>

		<div class="column">
			<div class="brand">
				@* The arena in miniature: five floors stepping down into lava. The same colours as
				   the tiles, so the mark is a diagram of the game, not decoration. *@
				<div class="stack">
					<div class="slab f0"></div>
					<div class="slab f1"></div>
					<div class="slab f2"></div>
					<div class="slab f3"></div>
					<div class="slab f4"></div>
					<div class="slab lava"></div>
				</div>

				<label class="wordmark">TNT RUN</label>
				<label class="pitch">Every tile you touch falls away. Be the last one standing.</label>
			</div>

			@if ( Browsing )
			{
				<BrowserPanel />
			}
			else
			{
				<div class="actions">
					<div class="action primary @HostClass" onclick=@Host>
						<i>@( IsBusy ? "hourglass_empty" : "play_arrow" )</i>
						<div class="text">
							<label class="name">@HostLabel</label>
							<label class="hint">@HostHint</label>
						</div>
					</div>

					<div class="action secondary @BusyClass" onclick=@Browse>
						<i>search</i>
						<div class="text">
							<label class="name">Find a game</label>
							<label class="hint">Browse open lobbies and jump in</label>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="footer">
			<div class="keys">
				<div class="key">W</div><div class="key">A</div><div class="key">S</div><div class="key">D</div>
				<label class="what">Move</label>
				<div class="key wide">Shift</div>
				<label class="what">Sprint</label>
				<div class="key wide">Space</div>
				<label class="what">Jump</label>
			</div>

			<label class="who">@PlayerName</label>
		</div>
	</div>
</root>

@code
{
	RoundManager Round => Scene.Get<RoundManager>();

	LobbyBrowser Browser => Scene.Get<LobbyBrowser>();

	bool Browsing => Browser?.IsBrowsing == true;

	/// <summary>Hosting or joining is in flight — both buttons stand down until it resolves.</summary>
	bool IsBusy => Round?.IsStartingLobby == true || Networking.IsConnecting;

	string BusyClass => IsBusy ? "busy" : "";

	string HostClass => IsBusy ? "busy pending" : "";

	string HostLabel => Networking.IsConnecting ? "Joining…" : IsBusy ? "Starting lobby…" : "Host a game";

	string HostHint => IsBusy ? "Hang tight, this takes a moment" : "Open a lobby others can find and join";

	string PlayerName => Connection.Local?.DisplayName ?? "";

	void Host()
	{
		if ( IsBusy ) return;

		Click();
		Round?.Host();
	}

	void Browse()
	{
		if ( IsBusy ) return;

		Click();
		Browser?.StartBrowsing();
	}

	static void Click() => Sound.Play( "sounds/kenney/ui/ui.button.press.sound" );

	protected override int BuildHash() => System.HashCode.Combine( Browsing, IsBusy, Networking.IsConnecting, PlayerName );
}
