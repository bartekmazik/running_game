@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox

@*
	The out-of-session shell. The title page sits on the left third over the live arena — MenuCamera
	orbits it — so the world itself is the backdrop. Loadout, profile and how-to-play open as big
	storybook cards in the middle; the lobby list takes the left column in place of the buttons.
*@

<root>
	<div class="menu page-@PageName">
		<div class="scrim"></div>

		@if ( Ui.Page == GameUi.MenuPage.Title || Ui.Page == GameUi.MenuPage.Browse )
		{
			<div class="column">
				<div class="brand">
					<label class="wordmark">TNT RUN</label>
					<div class="strata">
						@for ( var floor = 0; floor < Arena.FloorCount; floor++ )
						{
							<div class="stratum f@(floor)" @key=@floor></div>
						}
						<div class="stratum lava"></div>
					</div>
				</div>

				@if ( Ui.Page == GameUi.MenuPage.Browse )
				{
					<BrowserPanel />
				}
				else
				{
					<div class="actions">
						<div class="brick big @HostClass" onclick=@Host>
							<div class="glyph @( IsBusy ? "g-hourglass" : "g-host" )"></div>
							<label class="name">@HostLabel</label>
						</div>

						<div class="brick big sky @BusyClass" onclick=@Browse>
							<div class="glyph g-search"></div>
							<label class="name">FIND A GAME</label>
						</div>

						<div class="row">
							<div class="brick paper" onclick=@( () => Go( GameUi.MenuPage.Loadout ) )>
								<div class="glyph g-bolt"></div>
								<label>ABILITIES</label>
							</div>
							<div class="brick paper" onclick=@( () => Go( GameUi.MenuPage.Profile ) )>
								<div class="glyph g-trophy"></div>
								<label>RANK</label>
							</div>
							<div class="brick paper" onclick=@( () => Go( GameUi.MenuPage.HowTo ) )>
								<div class="glyph g-question"></div>
								<label>HELP</label>
							</div>
						</div>
					</div>
				}
			</div>

			<div class="rank-badge" onclick=@( () => Go( GameUi.MenuPage.Profile ) )>
				<div class="emblem art" style="background-image: url(@Ranks.Emblem( RankPoints ))"></div>
				<div class="text">
					<label class="who">@PlayerName</label>
					<label class="rank">@RankLine</label>
					<div class="progress">
						<div class="fill" style="width: @(Ranks.Progress( RankPoints ) * 100f)%; background-color: @Ranks.TierHex( Ranks.Tier( RankPoints ) )"></div>
					</div>
				</div>
			</div>

			<div class="loadout-chip" onclick=@( () => Go( GameUi.MenuPage.Loadout ) )>
				<AbilityChip Ability=@Profile.First Slot=@(0) />
				<AbilityChip Ability=@Profile.Second Slot=@(1) />
			</div>
		}
		else if ( Ui.Page == GameUi.MenuPage.Loadout )
		{
			<LoadoutPanel />
		}
		else if ( Ui.Page == GameUi.MenuPage.Profile )
		{
			<ProfilePanel />
		}
		else
		{
			<HowToPanel />
		}
	</div>
</root>

@code
{
	GameUi Ui => Scene.Get<GameUi>();

	RoundManager Round => Scene.Get<RoundManager>();

	ProfileStore Profile => Scene.Get<ProfileStore>();

	string PageName => Ui.Page.ToString().ToLowerInvariant();

	/// <summary>Hosting or joining is in flight — both buttons stand down until it resolves.</summary>
	bool IsBusy => Round?.IsStartingLobby == true || Networking.IsConnecting;

	string BusyClass => IsBusy ? "disabled" : "";

	string HostClass => IsBusy ? "disabled" : "";

	string HostLabel => Networking.IsConnecting ? "JOINING…" : IsBusy ? "STARTING…" : "HOST A GAME";

	string PlayerName => Connection.Local?.DisplayName ?? "";

	int RankPoints => Profile?.Profile.RankPoints ?? 0;

	string RankLine => Ranks.Name( RankPoints );

	void Host()
	{
		if ( IsBusy ) return;

		Sfx.Ui( Sfx.Click );
		Round?.Host();
	}

	void Browse()
	{
		if ( IsBusy ) return;
		Go( GameUi.MenuPage.Browse );
	}

	void Go( GameUi.MenuPage page )
	{
		Sfx.Ui( Sfx.Click );
		Ui.Open( page );
	}

	protected override int BuildHash() => HashCode.Combine( Ui?.Page, IsBusy, Networking.IsConnecting, PlayerName, Profile?.Revision );
}
